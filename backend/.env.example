# Copy to backend/.env and fill in. Never commit the real .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=himt_chatbot
CORS_ORIGINS=*
# Set to the built frontend (frontend/build) to serve the widget from the backend
WEB_DIST_DIR=

# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Required to use /api/admin/* endpoints (no default)
ADMIN_TOKEN=

HIMT_WEBSITE_URL=https://himtmarine.com
HIMT_ADDITIONAL_SITES=
DAILY_REINGEST_HOUR=2

# Optional weak-answer email alerts via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
WEAK_ANSWER_ALERT_TO=
WEAK_ANSWER_ALERT_MIN_INTERVAL_SEC=120
