<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site for the HIMT Assistant Bot. IIS receives the requests for the bot's
  host name (and handles HTTPS once a certificate is bound) and forwards
  everything to the Python service on port 8001, which serves both the API and
  the chat widget.
  Needs the IIS URL Rewrite and Application Request Routing (ARR) modules, with
  proxy enabled in ARR and HTTP_X_FORWARDED_PROTO added to the allowed server
  variables; deploy/windows/install.ps1 sets these up.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HIMT Assistant Bot over HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
        </rule>
        <rule name="HIMT Assistant Bot over HTTP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
